# agent-interp-envs environments/parse_duration/Dockerfile, minus the harness (it runs on the host here):
# python:3.11-slim, pyyaml/python-dotenv, git, durc.py installed as /usr/local/bin/durc (0755), a non-root `dev` user,
# an empty dev-owned /agent, root-only /opt. Hardened like donehack container/Containerfile: no setuid binaries.
# AGENT_UID 1000 (default) or 200 (--small-uid).
#
# Build (from this directory): ./build.sh
FROM docker.io/library/python:3.11-slim
ARG AGENT_UID=1000
ENV PYTHONUNBUFFERED=1
WORKDIR /agent
RUN pip install --no-cache-dir pyyaml python-dotenv \
 && apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY --from=aie durc.py /usr/local/bin/durc
RUN chmod 755 /usr/local/bin/durc \
 && groupadd -g ${AGENT_UID} dev && useradd -m -d /home/dev -s /bin/bash -u ${AGENT_UID} -g ${AGENT_UID} dev \
 && chown -R dev:dev /agent && chmod 700 /opt && chmod -R go-rwx /opt \
 && find / -xdev -type f -perm /6000 -exec chmod a-s {} + \
 && rm -f /usr/bin/su /usr/bin/mount /usr/bin/umount /usr/bin/newgrp /usr/bin/chsh /usr/bin/chfn /usr/bin/gpasswd /usr/bin/passwd
