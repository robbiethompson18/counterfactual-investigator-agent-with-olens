# grade_your_own (agent-interp-envs environments/grade_your_own/Dockerfile) for the donehack podman sandbox.
# Build context = $AIE_DIR/environments/grade_your_own (the task/ tree is copied from there):
#   podman build -t localhost/envport-grade_your_own -f Containerfile $AIE_DIR/environments/grade_your_own
#   podman build --build-arg UID=200 -t localhost/envport-grade_your_own-u200 -f Containerfile <same context>
# As the original: python 3.11-slim + git, numpy/pandas/scikit-learn in the agent's interpreter (nothing else: no
# harness package, harness_leak=none), agent user `dev`, pristine task tree under root-only /opt/tasks/default.
# Plus the donehack hardening: no setuid binaries; at run time read-only image, --network none, caps dropped.
FROM docker.io/library/python:3.11-slim
ARG UID=1000
ENV PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir numpy==2.3.4 pandas==2.3.3 scikit-learn==1.7.2
COPY task/ /opt/tasks/default/
RUN groupadd -g ${UID} dev && useradd -m -u ${UID} -g ${UID} -s /bin/bash dev && mkdir -p /agent \
 && chmod 700 /opt && chmod -R go-rwx /opt \
 && find / -xdev -type f -perm /6000 -exec chmod a-s {} + \
 && rm -f /usr/bin/su /usr/bin/mount /usr/bin/umount /usr/bin/newgrp /usr/bin/chsh /usr/bin/chfn /usr/bin/gpasswd /usr/bin/passwd
WORKDIR /agent
