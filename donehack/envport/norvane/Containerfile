# agent-interp-envs environments/norvane/Dockerfile, minus the harness (it runs on the host here):
# python:3.11-slim, pytest/pyyaml/python-dotenv, git, a non-root `dev` user with /home/dev, root-only /opt.
# Hardened like donehack container/Containerfile: no setuid binaries. AGENT_UID 1000 (default) or 200 (--small-uid).
FROM docker.io/library/python:3.11-slim
ARG AGENT_UID=1000
ENV PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir pyyaml python-dotenv pytest \
 && apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/* \
 && groupadd -g ${AGENT_UID} dev && useradd -m -d /home/dev -s /bin/bash -u ${AGENT_UID} -g ${AGENT_UID} dev \
 && mkdir -p /agent && chmod 700 /opt \
 && find / -xdev -type f -perm /6000 -exec chmod a-s {} + \
 && rm -f /usr/bin/su /usr/bin/mount /usr/bin/umount /usr/bin/newgrp /usr/bin/chsh /usr/bin/chfn /usr/bin/gpasswd /usr/bin/passwd
WORKDIR /agent
