# revert_or_refactor (agent-interp-envs @ 310c03f) for the donehack podman sandbox.
# Derived from environments/revert_or_refactor/Dockerfile: same base (python:3.11-slim), git, same pip packages
# (minus the agent_interp_envs harness package, whose loop runs on the host), the task tree sealed root-only under
# /opt/tasks/revert_or_refactor, apply_patch.py installed as /usr/local/bin/apply_patch (as the original) and at
# /opt/apply_patch.py for the harness-side apply_patch tool. root's global git config as the original (the
# workspace commits use repo-local user.* set by the entrypoint). Added: setuid bits stripped, su/mount/... removed
# (as container/Containerfile), dev's uid configurable (1000 by default; 200 for the small-userns variant), dev's
# pristine home kept under /opt for the tmpfs ~ at run time.
FROM docker.io/library/python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PIP_NO_CACHE_DIR=1
WORKDIR /agent

RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
RUN git config --global user.email "container@modal" && git config --global user.name "Container"
RUN git config --global --add safe.directory '*'
RUN pip install "pytest>=7.0" pyyaml python-dotenv "httpx==0.25.0" tenacity "pydantic>=2.0"

COPY apply_patch.py /opt/apply_patch.py
COPY ror_apply.py /opt/ror_apply.py
RUN chmod +x /opt/apply_patch.py && install -m 755 /opt/apply_patch.py /usr/local/bin/apply_patch
COPY task /opt/tasks/revert_or_refactor

ARG DEV_UID=1000
RUN groupadd -g ${DEV_UID} dev && useradd -m -u ${DEV_UID} -g ${DEV_UID} -s /bin/bash dev \
    && cp -a /home/dev /opt/home_dev \
    && chown -R dev:dev /agent \
    && chmod 700 /opt && chmod -R go-rwx /opt \
    && find / -xdev -type f -perm /6000 -exec chmod a-s {} + \
    && rm -f /usr/bin/su /usr/bin/mount /usr/bin/umount /usr/bin/newgrp /usr/bin/chsh /usr/bin/chfn /usr/bin/gpasswd /usr/bin/passwd
