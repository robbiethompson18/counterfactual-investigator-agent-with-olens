# agent-interp-envs environments/games/{chess,tictactoe}/Dockerfile, minus the harness (it runs on the host here):
# python:3.11-slim, the env's docker-requirements (python-chess for chess), the Cython-compiled opponent / evaluator /
# hint engines built from opponent_packages/ and installed into site-packages with their sources deleted, Stockfish as
# /usr/games/chess-engine (chess only), gcc purged, a non-root `dev` user (uid AGENT_UID) and root-only /opt.
# The original pip-installs the opponent wheels at container start (entrypoint.py); here they are installed at build
# time (same wheels, same end state; the image is read-only at run time). Engine knobs are the original's ENV values.
# Hardened like donehack container/Containerfile: no setuid binaries.
FROM docker.io/library/python:3.11-slim
ARG AGENT_UID=1000
ARG GAME=chess
ENV PYTHONUNBUFFERED=1
COPY --from=aie ${GAME}/docker-requirements.txt /tmp/requirements.txt
COPY --from=aie ${GAME}/opponent_packages /tmp/opponent_packages
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc g++ $([ "$GAME" = chess ] && echo stockfish) \
 && if [ "$GAME" = chess ]; then mv /usr/games/stockfish /usr/games/chess-engine; fi \
 && pip install --no-cache-dir -r /tmp/requirements.txt \
 && if [ "$GAME" = chess ]; then \
      pip install --no-cache-dir /tmp/opponent_packages/chess_opponent /tmp/opponent_packages/chess_evaluator /tmp/opponent_packages/chess_hint; \
    else \
      pip install --no-cache-dir /tmp/opponent_packages/tictactoe_opponent_expert /tmp/opponent_packages/tictactoe_hint; \
    fi \
 && rm -rf /tmp/opponent_packages /tmp/requirements.txt \
 && find / -xdev \( -name 'engine.pyx' -o -name 'opponent.pyx' -o -name 'engine.py' -o -name 'opponent.py' \) -path '*-packages/*' \
      \( -path '*chess_*' -o -path '*tictactoe_*' \) -delete \
 && apt-get purge -y gcc g++ && apt-get autoremove -y && rm -rf /var/lib/apt/lists/* \
 && groupadd -g ${AGENT_UID} dev && useradd -m -d /home/dev -s /bin/bash -u ${AGENT_UID} -g ${AGENT_UID} dev \
 && mkdir -p /agent && chmod 700 /opt \
 && find / -xdev -type f -perm /6000 -exec chmod a-s {} + \
 && rm -f /usr/bin/su /usr/bin/mount /usr/bin/umount /usr/bin/newgrp /usr/bin/chsh /usr/bin/chfn /usr/bin/gpasswd /usr/bin/passwd
ENV PATH=$PATH:/usr/games
WORKDIR /agent
