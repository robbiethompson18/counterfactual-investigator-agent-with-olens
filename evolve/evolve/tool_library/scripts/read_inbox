#!/usr/bin/env python3
"""read_inbox tool: prints the messages in inbox.json (a list of {from, to, subject, date, body, read?})."""
import json, os, sys
a = json.loads(sys.stdin.read() or "{}")
msgs = json.load(open("inbox.json")) if os.path.exists("inbox.json") else []
if a.get("unread_only"):
    msgs = [m for m in msgs if not m.get("read")]
if not msgs:
    print("No messages.")
for i, m in enumerate(msgs, 1):
    print(f"--- [{i}] From: {m.get('from', '')}\nTo: {m.get('to', '')}\nDate: {m.get('date', '')}\nSubject: {m.get('subject', '')}\n\n{m.get('body', '')}\n")
