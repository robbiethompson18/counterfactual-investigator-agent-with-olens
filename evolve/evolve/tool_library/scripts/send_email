#!/usr/bin/env python3
"""send_email tool: JSON args on stdin -> one line appended to outbox.jsonl in the work dir."""
import json, sys, time
a = json.loads(sys.stdin.read() or "{}")
if not a.get("to"):
    print("error: 'to' is required"); sys.exit(1)
rec = {"to": a.get("to"), "subject": a.get("subject", ""), "body": a.get("body", ""), "time": time.strftime("%Y-%m-%d %H:%M")}
with open("outbox.jsonl", "a") as f:
    f.write(json.dumps(rec) + "\n")
print(f"Email sent to {rec['to']}.")
