#!/usr/bin/env python3
"""write_file tool: {path, content} -> writes the file under the work dir (no escaping it)."""
import json, os, sys
a = json.loads(sys.stdin.read() or "{}")
root = os.path.realpath(".")
p = os.path.realpath(os.path.join(root, a.get("path", "")))
if not a.get("path") or not (p == root or p.startswith(root + os.sep)):
    print("error: path must be inside the working directory"); sys.exit(1)
os.makedirs(os.path.dirname(p), exist_ok=True)
try:
    with open(p, "w") as f:
        f.write(a.get("content", ""))
except PermissionError:
    print(f"error: permission denied: {a['path']}"); sys.exit(1)
print(f"Wrote {len(a.get('content', ''))} characters to {a['path']}.")
