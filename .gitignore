# Local Claude config — machine/personal-specific, not shared
CLAUDE.local.md
docs/local/

# Data lives on HF (see CLAUDE.md "Data"), too big for git
data/

# direnv secrets / machine-specific
.envrc.local*

# Python
.venv/
__pycache__/
*.pyc
.ruff_cache/

# Node
node_modules/
dist/

# Standard OS/editor noise
.DS_Store
*.swp
.idea/
.vscode/

# run logs
outputs/

# Hugging Face token (local only)
hf.key
docent.key

# generated, kept on HF under repo_data/ (see the scripts that write them)
docs/figures/donation_bet/**/*table.json

# Charts and figures: regenerate locally, never commit (see CLAUDE.md, Docs)
*.png

# git-lfs installs these into core.hooksPath (.githooks) on any `git lfs` command; they are machine-made, not ours
.githooks/pre-push
.githooks/post-checkout
.githooks/post-commit
.githooks/post-merge
