# Slide figures: graphs/style.py's look at the deck's sizes. Saved at their natural size and included unscaled, so 8pt here is 8pt on
# the slide, next to the 9pt body text.
font.size: 8
axes.titlesize: 8.5
axes.labelsize: 8
xtick.labelsize: 7.5
ytick.labelsize: 7.5
legend.fontsize: 7.5
pdf.fonttype: 42
savefig.transparent: True
savefig.format: pdf
