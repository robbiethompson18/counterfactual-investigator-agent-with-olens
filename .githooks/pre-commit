#!/bin/sh
# Ruff and ty on staged Python files, and docs/final-writeup.html rebuilt whenever its Markdown is staged.
# Enable once per clone: git config core.hooksPath .githooks
# The HTML is built from the working tree's Markdown, not the staged copy.
if git diff --cached --name-only -- docs/final-writeup.md scripts/build_writeup.sh | grep -q .; then
  git lfs update >/dev/null 2>&1 # make sure git-lfs's pre-push hook is in .githooks, so the push uploads the HTML
  sh scripts/build_writeup.sh && git add docs/final-writeup.html || {
    echo "pre-commit: building docs/final-writeup.html failed; a missing chart PNG is the usual cause (regenerate it)." >&2
    exit 1
  }
fi
files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
[ -z "$files" ] && exit 0
# --force-exclude so explicitly passed vendor/ paths still honor the pyproject excludes
uv run --quiet ruff check --force-exclude $files && uv run --quiet ruff format --check --force-exclude $files || {
  echo "pre-commit: ruff failed. Fix with: uv run ruff check --fix . && uv run ruff format ." >&2
  exit 1
}
uv run --quiet ty check --force-exclude $files || {
  echo "pre-commit: ty failed. Fix the types (or a per-line '# ty: ignore[rule]' if a fix needs a redesign)." >&2
  exit 1
}
