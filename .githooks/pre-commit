#!/bin/sh
# Ruff on staged Python files. Enable once per clone: git config core.hooksPath .githooks
files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
[ -z "$files" ] && exit 0
# --force-exclude so explicitly passed vendor/ paths still honor extend-exclude
uv run --quiet ruff check --force-exclude $files && uv run --quiet ruff format --check --force-exclude $files || {
  echo "pre-commit: ruff failed. Fix with: uv run ruff check --fix . && uv run ruff format ." >&2
  exit 1
}
